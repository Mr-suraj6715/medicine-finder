# Next.js Frontend — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local to Git.

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the FastAPI Python backend (used by Next.js rewrites in next.config.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Prisma / Database ────────────────────────────────────────────────────────
# Used by Prisma ORM for migrations and seeding
DATABASE_URL=postgresql://user:password@localhost:5432/medifind

# ─── App Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=MediFind
APP_URL=http://localhost:3000

# ─── Google Maps Platform ──────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY_HERE
GOOGLE_MAPS_SERVER_API_KEY=YOUR_GOOGLE_MAPS_SERVER_KEY_HERE

# ─── Resend Transactional Email ───────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="MediFind <onboarding@resend.dev>"
