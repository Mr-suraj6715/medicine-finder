# Python Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to Git.

# ─── Database ────────────────────────────────────────────────────────────────
# Production: PostgreSQL connection string (Prisma format)
DATABASE_URL=postgresql://user:password@localhost:5432/medifind

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
